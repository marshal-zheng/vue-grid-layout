{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "preserve",
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": ".",
    "stripInternal": true,
    "skipLibCheck": true
  },
  "include": ["lib/**/*.ts", "lib/**/*.tsx"],
  "exclude": ["mcp", "node_modules", "dist", "build", ".tmp", "test", "example"]
}
